<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لعبة الصناديق السحرية | LYORA</title>

<script src="https://cdn.tailwindcss.com"></script>

<style>
body{
  background: linear-gradient(135deg,#22c55e,#dc2626,#facc15);
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-direction:column;
  color:white;
  font-family:sans-serif;
  overflow:hidden;
}

h1{
  font-size:2rem;
  text-shadow:0 0 5px #fff,0 0 15px #22c55e;
  text-align:center;
}

/* ===== كلمات حماسية متحركة ===== */
#hype{
  font-size:1.5rem;
  font-weight:bold;
  margin-top:1rem;
  animation: blink 1s linear infinite;
  text-shadow: 0 0 5px #fff, 0 0 10px #facc15, 0 0 20px #22c55e, 0 0 30px #dc2626;
}

@keyframes blink{
  0%,50%,100%{opacity:1;}
  25%,75%{opacity:0.6;}
}

.box-container{
  display:flex;
  gap:20px;
  margin-top:2rem;
}

.magic-box{
  width:120px;
  height:120px;
  background:black;
  border-radius:1rem;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:2rem;
  cursor:pointer;
  position:relative;
  overflow:hidden;
  box-shadow:0 0 10px #fff,0 0 20px #22c55e,0 0 40px #facc15;
  transition:0.3s transform;
}

.magic-box:hover{
  transform:scale(1.1);
}

.magic-box img{
  width:100%;
  height:100%;
  object-fit:cover;
  border-radius:1rem;
}

#result{
  margin-top:2rem;
  font-size:1.5rem;
  font-weight:bold;
  color:#ff3f3f;
  display:none;
}
</style>
</head>

<body>

<h1>اختر الصندوق السحري 🎁</h1>

<div id="hype">🎉 جرب حظك الآن! كل شيء ممكن! 🔥🚀</div>

<div class="box-container">
  <div class="magic-box" id="box1">
    <img src="perfume1.jpg" alt="عطر 1">
  </div>
  <div class="magic-box" id="box2">
    <img src="perfume1.jpg" alt="عطر 2">
  </div>
  <div class="magic-box" id="box3">
    <img src="perfume1.jpg" alt="عطر 3">
  </div>
</div>

<div id="result">🚫 خسرت! إعادة التوجيه للمتجر...</div>

<script>
const boxes = document.querySelectorAll(".magic-box");
const result = document.getElementById("result");

boxes.forEach(box=>{
  box.addEventListener("click", ()=>{
    boxes.forEach(b=>b.style.pointerEvents="none");
    result.style.display="block";

    setTimeout(()=>{
      window.location.href = "index.html";
    }, 1500);
  });
});
</script>

</body>
</html>
